#include <stdio.h>

struct Student {
    char name[50];
    int id;
    float percentage;
};

int main() {
    int n;
    printf("Enter number of students: ");
    scanf("%d", &n);

    struct Student s[n];
    struct Student *ptr = s;

    // Input student details
    for (int i = 0; i < n; i++) {
        printf("\nEnter details for student %d:\n", i + 1);
        printf("Name: ");
        scanf(" %[^\n]", (ptr + i)->name);
        printf("ID: ");
        scanf("%d", &(ptr + i)->id);
        printf("Percentage: ");
        scanf("%f", &(ptr + i)->percentage);
    }

    // Find student with highest percentage
    struct Student *topper = ptr;
    for (int i = 1; i < n; i++) {
        if ((ptr + i)->percentage > topper->percentage) {
            topper = (ptr + i);
        }
    }

    // Display topper details
    printf("\n--- Student with Highest Percentage ---\n");
    printf("Name: %s\n", topper->name);
    printf("ID: %d\n", topper->id);
    printf("Percentage: %.2f%%\n", topper->percentage);

    return 0;
}
