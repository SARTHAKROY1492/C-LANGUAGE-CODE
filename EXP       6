#include <stdio.h>

int main() {
    char str[100];
    int i = 0, count = 0;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    // Traverse the string until the null terminator or newline character
    while (str[i] != '\0' && str[i] != '\n') {
        // Convert lowercase to uppercase
        if (str[i] >= 'a' && str[i] <= 'z') {
            str[i] = str[i] - 32;
        }
        // Convert uppercase to lowercase
        else if (str[i] >= 'A' && str[i] <= 'Z') {
            str[i] = str[i] + 32;
        }

        count++;
        i++;
    }

    // Ensure proper null termination if newline was encountered
    str[i] = '\0';

    printf("Converted string: %s\n", str);
    printf("Total number of characters: %d\n", count);

    return 0;
}
