#include <stdio.h>

int main() {
    int arr[100], n, i, pos, val;

    // Input the current number of elements
    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);

    // Input the array elements
    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Input the element to insert and the target index
    printf("Enter the element to insert: ");
    scanf("%d", &val);
    printf("Enter the index (0 to %d) where you want to insert: ", n);
    scanf("%d", &pos);

    // Validate the index
    if (pos < 0 || pos > n) {
        printf("Invalid index! Insertion failed.\n");
    } else {
        // Shift elements to the right
        for (i = n - 1; i >= pos; i--) {
            arr[i + 1] = arr[i];
        }

        // Insert the new element and update size
        arr[pos] = val;
        n++;

        // Display the updated array
        printf("Array after insertion:\n");
        for (i = 0; i < n; i++) {
            printf("%d ", arr[i]);
        }
        printf("\n");
    }

    return 0;
}
