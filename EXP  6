#include <stdio.h>

int main() {
    char str[100], temp;
    int length = 0, i, j;

    // Input the string
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    // Find the length of the string manually (excluding newline/null)
    while (str[length] != '\0' && str[length] != '\n') {
        length++;
    }
    str[length] = '\0'; // Remove trailing newline if present

    // Reverse the string in-place by swapping characters
    i = 0;
    j = length - 1;
    while (i < j) {
        temp = str[i];
        str[i] = str[j];
        str[j] = temp;
        i++;
        j--;
    }

    // Output the reversed string
    printf("Reversed string: %s\n", str);

    return 0;
}
