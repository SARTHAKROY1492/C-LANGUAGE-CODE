#include <stdio.h>

int main() {
    int arr[100], n, i, element, pos = -1;

    // Step 1: Input array size and elements
    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Step 2: Input the element to delete
    printf("Enter the element to delete: ");
    scanf("%d", &element);

    // Step 3: Find the index of the element
    for (i = 0; i < n; i++) {
        if (arr[i] == element) {
            pos = i;
            break; // Stops at the first occurrence
        }
    }

    // Step 4: Shift elements left if found
    if (pos != -1) {
        for (i = pos; i < n - 1; i++) {
            arr[i] = arr[i + 1];
        }
        n--; // Reduce array size by 1

        // Step 5: Display the updated array
        printf("Array after deletion:\n");
        for (i = 0; i < n; i++) {
            printf("%d ", arr[i]);
        }
        printf("\n");
    } else {
        printf("Element %d not found in the array.\n", element);
    }

    return 0;
}
