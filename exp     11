#include <stdio.h>

int* findMax(int *arr, int n) {
    int *maxPtr = arr; // Point to the first element initially
    for (int i = 1; i < n; i++) {
        if (*(arr + i) > *maxPtr) {
            maxPtr = (arr + i); // Update pointer to the larger element's address
        }
    }
    return maxPtr;
}

int main() {
    int n;
    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", (arr + i));
    }

    int *max = findMax(arr, n);
    printf("Maximum number in the array is: %d\n", *max);

    return 0;
}
